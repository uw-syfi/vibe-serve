{
  "name": "@vibesys/tui",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uw-syfi/vibesys.git"
  },
  "bugs": {
    "url": "https://github.com/uw-syfi/vibesys/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibesys": "./dist/launcher.js",
    "vs": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @vibesys/tui^... build",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.json",
    "precheck": "pnpm --filter @vibesys/tui^... build",
    "check": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build",
    "pretest": "pnpm --filter @vibesys/tui^... build",
    "test": "bun test --max-concurrency 1 src dev"
  },
  "dependencies": {
    "@vibesys/backend-client": "workspace:*",
    "@vibesys/core-state": "workspace:*",
    "@opentui/core": "0.4.3"
  },
  "bundledDependencies": [
    "@vibesys/backend-client",
    "@vibesys/core-state"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/bun": "1.3.9",
    "typescript": "^5.8.3"
  }
}
