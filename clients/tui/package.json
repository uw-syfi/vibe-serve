{
  "name": "@vibesys/tui",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uw-syfi/vibesys.git"
  },
  "bugs": {
    "url": "https://github.com/uw-syfi/vibesys/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibesys": "./dist/launcher.js",
    "vs": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "generate:protocol": "uv run --project ../.. python -m vibesys.server.schema src/generated/protocol.schema.json && json2ts -i src/generated/protocol.schema.json -o src/generated/protocol.generated.ts --bannerComment '/* Generated from the Python protocol models. Do not edit. */'",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build",
    "test": "bun test --max-concurrency 1 src"
  },
  "dependencies": {
    "@opentui/core": "0.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/bun": "1.3.9",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3"
  }
}
